{
  "name": "wavebench",
  "version": "0.1.0",
  "private": true,
  "description": "Signal-processing workbench in the browser for raw sensor records such as 3-axis acceleration: timebase, filters, FFT, Welch PSD and STFT spectrograms, with WebGPU compute and a Float64 CPU reference.",
  "license": "Apache-2.0",
  "author": "Kursat Kilic",
  "homepage": "https://kilickursat.github.io/WaveBench/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kilickursat/WaveBench.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "fixtures": "python reference/generate_fixtures.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "0.1.74",
    "playwright": "1.59.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
